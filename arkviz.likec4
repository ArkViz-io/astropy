specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projResearcher = actor 'Researcher' {
    description 'An astronomer or researcher who uses Astropy for data analysis and scientific computing'
  }

  projDeveloper = actor 'Astropy Contributor' {
    description 'A developer who contributes code, documentation, or tests to the Astropy project'
  }

  projAstropySystem = system 'Astropy' {
    description 'A core Python library for Astronomy and Astrophysics'

    projCoreLib = service 'Astropy Core Library' {
      technology 'Python, C, Cython'
      description 'The main library providing core functionality for astronomy'
      metadata {
        sourceFiles 'astropy/__init__.py, astropy/config/configuration.py, astropy/utils/data.py'
      }

      projUnitsModule = component 'Units & Quantities' {
        technology 'Python'
        description 'Handles physical units and quantities with unit conversion'
        metadata {
          sourceFiles 'astropy/units/core.py, astropy/units/quantity.py'
        }
      }

      projCoordinatesModule = component 'Coordinates' {
        technology 'Python, C'
        description 'Provides support for celestial coordinates and transformations'
        metadata {
          sourceFiles 'astropy/coordinates/sky_coordinate.py, astropy/coordinates/baseframe.py'
        }
      }

      projIoModule = component 'I/O Registry' {
        technology 'Python'
        description 'Unified interface for reading and writing various data formats'
        metadata {
          sourceFiles 'astropy/io/registry/core.py, astropy/io/fits/__init__.py, astropy/io/ascii/core.py'
        }
      }

      projTableModule = component 'Table' {
        technology 'Python, Cython'
        description 'High-level container for heterogeneous data'
        metadata {
          sourceFiles 'astropy/table/table.py, astropy/table/column.py'
        }
      }

      projTimeModule = component 'Time' {
        technology 'Python, C'
        description 'Handles time and dates with high precision'
        metadata {
          sourceFiles 'astropy/time/core.py, astropy/time/formats.py'
        }
      }

      projModelingModule = component 'Modeling' {
        technology 'Python'
        description 'Framework for representing and fitting models to data'
        metadata {
          sourceFiles 'astropy/modeling/core.py, astropy/modeling/fitting.py'
        }
      }

      projWcsModule = component 'WCS' {
        technology 'Python, C'
        description 'World Coordinate System support'
        metadata {
          sourceFiles 'astropy/wcs/wcs.py'
        }
      }

      projSampModule = component 'SAMP' {
        technology 'Python'
        description 'Simple Application Messaging Protocol implementation'
        metadata {
          sourceFiles 'astropy/samp/hub.py, astropy/samp/client.py'
        }
      }

      projUnitsModule -> projCoordinatesModule 'provides units for'
      projTimeModule -> projCoordinatesModule 'provides time context for'
      projIoModule -> projTableModule 'loads data into'
      projTableModule -> projModelingModule 'provides data for fitting'
    }

    projFitsScripts = service 'FITS Utilities' {
      technology 'Python'
      description 'Command-line tools for managing FITS files'
      metadata {
        sourceFiles 'astropy/io/fits/scripts/fitscheck.py, astropy/io/fits/scripts/fitsdiff.py'
      }
    }

    projSampHub = service 'SAMP Hub' {
      technology 'Python'
      description 'A hub for the Simple Application Messaging Protocol'
      metadata {
        sourceFiles 'astropy/samp/hub_script.py'
      }
    }

    projCoreLib -> projFitsScripts 'powers'
    projCoreLib -> projSampHub 'implements protocol for'
  }

  projNumpy = external 'NumPy' {
    description 'Fundamental package for scientific computing with Python'
  }

  projPyErfa = external 'PyERFA' {
    description 'Python bindings for ERFA (Essential Routines for Fundamental Astronomy)'
  }

  projPyYaml = external 'PyYAML' {
    description 'YAML parser and emitter for Python'
  }

  projIersData = external 'astropy-iers-data' {
    description 'IERS data for Astropy'
  }

  projGitHub = external 'GitHub' {
    description 'Hosting for the repository, CI/CD, and issue tracking'
  }

  projPyPI = external 'PyPI' {
    description 'Python Package Index for distribution'
  }

  projResearcher -> projAstropySystem.projCoreLib 'uses for analysis' {
    technology 'Python API'
  }

  projResearcher -> projAstropySystem.projFitsScripts 'runs' {
    technology 'CLI'
  }

  projDeveloper -> projGitHub 'pushes code to' {
    technology 'Git/HTTPS'
  }

  projAstropySystem.projCoreLib -> projNumpy 'depends on'
  projAstropySystem.projCoreLib -> projPyErfa 'depends on'
  projAstropySystem.projCoreLib -> projPyYaml 'depends on'
  projAstropySystem.projCoreLib -> projIersData 'depends on'

  projGitHub -> projPyPI 'publishes releases to' {
    technology 'GitHub Actions'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projUserMachine = node 'User Local Machine' {
      projPythonEnv = node 'Python Environment' {
        instanceOf projAstropySystem.projCoreLib
      }
    }
  }

  projCIEnv = environment 'CI/CD' {
    projGHActions = zone 'GitHub Actions' {
      projTestNode = node 'Test Runner' {
        description 'Runs tox and pytest'
      }
      projBuildNode = node 'Build Runner' {
        description 'Builds wheels and source distributions'
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Astropy'
    description 'The Astropy library and its ecosystem of users, developers, and dependencies'
    include *
  }

  view projectContainers of projAstropySystem {
    title 'Containers - Astropy'
    description 'Major components and command-line utilities within the Astropy system'
    include *
  }

  view projectComponents of projAstropySystem.projCoreLib {
    title 'Components - Astropy Core Library'
    description 'Internal modules providing specific astronomical functionality'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Astropy'
    description 'How Astropy is distributed and used in local environments'
    include *
  }
}