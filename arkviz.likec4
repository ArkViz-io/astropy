specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projAstronomer = actor 'Astronomer' {
    description 'A scientist or researcher using Astropy for data analysis and astronomical calculations.'
  }

  projDeveloper = actor 'Developer' {
    description 'A software developer contributing to or extending the Astropy library.'
  }

  projAstropySystem = system 'Astropy' {
    description 'A core Python library for astronomy and astrophysics, providing data structures, coordinate transformations, and I/O for astronomical data formats.'

    projCoreLibrary = service 'Astropy Core Library' {
      technology 'Python, C, Cython'
      description 'The main library containing core astronomical logic, data structures, and algorithms.'
      metadata {
        sourceFiles 'astropy/__init__.py, astropy/coordinates/__init__.py, astropy/units/__init__.py, astropy/table/__init__.py'
      }

      projCoordinates = component 'Coordinates Module' {
        technology 'Python'
        description 'Handles celestial coordinate systems and transformations.'
        metadata {
          sourceFiles 'astropy/coordinates/sky_coordinate.py, astropy/coordinates/baseframe.py'
        }
      }

      projUnits = component 'Units & Quantities' {
        technology 'Python'
        description 'Provides a framework for physical units and dimensioned quantities.'
        metadata {
          sourceFiles 'astropy/units/core.py, astropy/units/quantity.py'
        }
      }

      projTables = component 'Table Module' {
        technology 'Python, Cython'
        description 'High-level container for heterogeneous data tables.'
        metadata {
          sourceFiles 'astropy/table/table.py, astropy/table/column.py'
        }
      }

      projIoRegistry = component 'I/O Registry' {
        technology 'Python'
        description 'Unified interface for reading and writing various astronomical data formats.'
        metadata {
          sourceFiles 'astropy/io/registry/core.py'
        }
      }

      projCoordinates -> projUnits 'uses for angular values'
      projTables -> projUnits 'uses for column units'
    }

    projFitsIo = service 'FITS I/O' {
      technology 'Python, C'
      description 'Handles Flexible Image Transport System (FITS) files, the standard data format in astronomy.'
      metadata {
        sourceFiles 'astropy/io/fits/__init__.py, astropy/io/fits/hdu/compressed/settings.py'
      }
    }

    projVotableIo = service 'VOTable I/O' {
      technology 'Python, C (Expat)'
      description 'Handles Virtual Observatory (VO) XML-based table formats.'
      metadata {
        sourceFiles 'astropy/io/votable/__init__.py, cextern/expat/README.md'
      }
    }

    projSampHub = service 'SAMP Hub' {
      technology 'Python'
      description 'Implements the Simple Applications Messaging Protocol (SAMP) for inter-tool communication.'
      metadata {
        sourceFiles 'astropy/samp/hub.py, astropy/samp/hub_script.py'
      }
    }

    projCoreLibrary -> projFitsIo 'reads/writes FITS data'
    projCoreLibrary -> projVotableIo 'reads/writes VOTable data'
  }

  projIersData = external 'IERS Data' {
    description 'International Earth Rotation and Reference Systems Service data for precise time and coordinate transformations.'
  }

  projPyErfa = external 'PyERFA' {
    technology 'C, Python'
    description 'Python bindings for the Essential Routines for Fundamental Astronomy (ERFA) library.'
  }

  projNumpy = external 'NumPy' {
    technology 'Python, C'
    description 'Fundamental package for scientific computing with Python, used for array operations.'
  }

  projAstronomer -> projAstropySystem 'performs analysis'
  projDeveloper -> projAstropySystem 'contributes code'
  projAstropySystem.projCoreLibrary -> projIersData 'fetches earth rotation data'
  projAstropySystem.projCoreLibrary -> projPyErfa 'delegates fundamental astronomy routines'
  projAstropySystem.projCoreLibrary -> projNumpy 'uses for array processing'
}

deployment {
  projLocalEnv = environment 'User Local Environment' {
    projUserNode = node 'Python Runtime' {
      instanceOf projAstropySystem.projCoreLibrary
    }
  }
}

views {
  view projectContext {
    title 'System Context - Astropy'
    description 'The Astropy library and its interactions with astronomers, developers, and fundamental data/libraries.'
    include *
  }

  view projectContainers of projAstropySystem {
    title 'Containers - Astropy'
    description 'Major sub-packages and I/O handlers within the Astropy core library.'
    include *
  }

  view projectComponents of projAstropySystem.projCoreLibrary {
    title 'Components - Astropy Core'
    description 'Internal modules providing the primary astronomical functionality.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Astropy'
    description 'Astropy is typically deployed as a library within a user\'s local Python environment.'
    include *
  }
}